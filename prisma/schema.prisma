generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

enum EventType {
  INTERVIEW
  TASK
  FOLLOW_UP
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("users")
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  company     String
  position    String
  location    String?
  jobUrl      String?
  salary      String?
  appliedDate DateTime          @default(now())
  status      ApplicationStatus @default(WISHLIST)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events    Event[]
  documents Document[]

  @@index([userId])
  @@index([status])
  @@map("applications")
}

model Event {
  id            String    @id @default(cuid())
  applicationId String
  title         String
  eventDate     DateTime
  type          EventType @default(INTERVIEW)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("events")
}

model Document {
  id            String   @id @default(cuid())
  applicationId String
  fileName      String
  fileKey       String   @unique
  fileType      String
  fileSize      Int
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("documents")
}